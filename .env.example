ENV=development

# Generate a real secret for production: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

DATABASE_URL=sqlite:///./rbac_rag.db
CHROMA_PERSIST_DIR=./chroma_db

# extractive = no external API needed (offline demo mode)
# openai     = real generative answers, requires OPENAI_API_KEY
LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared secret the n8n workflow sends in the X-Webhook-Token header
INGEST_WEBHOOK_TOKEN=CHANGE_ME_WEBHOOK_TOKEN
